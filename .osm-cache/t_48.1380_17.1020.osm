 <node id="8047250268" visible="true" version="3" changeset="167106249" timestamp="2025-06-02T19:17:16Z" user="Matthew Hostak" uid="11700798" lat="48.1411777" lon="17.1049983">
  <tag k="artist_name" v="Miro Regitko"/>
  <tag k="direction" v="320"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Na pamiatku 1462 detí z trenčianskej a nitrianskej župy, ďalších desaťtisícov slovenských detí deportovaných na maďarské územie Uhorska a cieľavedome odnárodňovaných v druhej polovici 19. a začiatkom 20. storočia."/>
  <tag k="inscription:en" v="In commemoration of 1462 children from Nitra and Trenčín counties and further tens of thousands of Slovak children deported to the Hungarian territory and purposively denationalized in the second half of the 19th and at the beginning of the 20th century."/>
  <tag k="material" v="stone"/>
  <tag k="memorial" v="plaque"/>
  <tag k="panoramax" v="f3e64c0e-753e-465e-8dac-4b3c52976674"/>
  <tag k="source" v="survey;https://pam.epocha.sk/pamatniky-bratislava/stare-mesto/odnarodnovanie-slovenskych-deti-panska-41"/>
  <tag k="start_date" v="1998-06-01"/>
 </node>
