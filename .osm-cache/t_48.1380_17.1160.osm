 <node id="9656810514" visible="true" version="3" changeset="169207053" timestamp="2025-07-20T17:27:27Z" user="Matthew Hostak" uid="11700798" lat="48.1404336" lon="17.1163578">
  <tag k="artist_name" v="Karol Rosmány"/>
  <tag k="direction" v="80"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="&quot;Zoberme ako občania svoje záležitosti do vlastných rúk!&quot; - V tejto budove dňa 20. novembra 1989 vzniklo prvé vyhlásenie Verejnosti proti násiliu, ktorá spolu so Študentským hnutím bola hlavnou iniciátorkou Nežnej revolúcie na Slovensku."/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Verejnosť proti násiliu, Študentské hnutie"/>
  <tag k="source" v="survey;https://pam.epocha.sk/pamatniky-bratislava/stare-mesto/nezna-revolucia-gondova-2"/>
  <tag k="start_date" v="2019-11-14"/>
 </node>
