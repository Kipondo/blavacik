  <tag k="artist_name" v="Andrej Baník"/>
  <tag k="description:en" v="Map meridian passing through the north-eastern tower of the Bratislava Castle. introduced Samuel Mikovíny in 1733 (at that time the Bratislava the capital of Royal Hungary). (Source: Wikipedia:sk)"/>
  <tag k="direction" v="175"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Týmto miestom prechádzal Bratislavský poludník orientovaný na severovýchodnú vežu Bratislavského hradu, ktorý určil v r. 1733 Samueml Mikovíni (1686-1750) ako základný poludník zemepisnej siete pre ním vyhotovené astronomicko-geometrické mapy"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Bratislavský poludník"/>
  <tag k="name:en" v="Bratislava meridian"/>
