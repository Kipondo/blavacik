  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Nezabudni, pamätaj! | Nám smrť otvorila náruč, vypľula mraky popola | Popol našich otcov, detí, mám | Popol čísiel bez mena. | Venované židovským spoluobčanom deportovaným v rokoch 1942-1945 zo železničnej stanice Nivy, ktorá sa nachádzala v tejto oblasti"/>
  <tag k="inscription:en" v="Don't forget, remember! | Death opened its arms to us, spat out clouds of ashes | The ashes of our fathers, children, mothers | Ashes of numbers without name. | Dedicated to our Jewish compatriots deported between 1942 and 1945 from the Nivy rail stati..."/>
  <tag k="memorial" v="plaque"/>
  <tag k="start_date" v="september 2024"/>
 </node>
