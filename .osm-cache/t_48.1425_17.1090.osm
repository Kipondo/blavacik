 <node id="915764726" visible="true" version="3" changeset="104659682" timestamp="2021-05-13T21:23:04Z" user="aceman444" uid="1617449" lat="48.1457506" lon="17.1106461">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="&quot;Len ten, kto si slobodu vybojoval, je jej hoden&quot; Na tomto mieste sme sa v novembri 1989 rozhodli vziať zodpovednosť za budúcnosť do svojich rúk. Rozhodli sme sa skoncovať s komunizmom a nastoliť slobodu a demokraciu."/>
  <tag k="material" v="stone"/>
  <tag k="memorial" v="plaque"/>
 </node>
