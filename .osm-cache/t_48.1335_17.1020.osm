  <tag k="description" v="460 mŕtvych väzňov tábora Engerau, ktorých roku 1945 exhumovala slovenská vyšetrovacia komisia, vrátane viac ako 100 obetí evakuačného pochodu, pripomína pamätník na cintoríne v Petržalke aj pamätné tabule vo Wolfsthale a Bad Deutsch-Altenburgu."/>
  <tag k="direction" v="275"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Počas nacistickej hrôzovlády sa od novembra 1944 do marca 1945 nachádzal v Petržalke tábor pre maďarských Židov, ... Nikdy nezabudneme na utrpenie obetí ani na zločiny páchateľov. Nikdy viac!"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Koncentračný tábor v Petržalke (Engerau)"/>
  <tag k="source" v="survey;https://pam.epocha.sk/pamatniky-bratislava/petrzalka-jarovce-rusovce-cunovo/koncentracny-tabor-viedenska-cesta-c-257"/>
  <tag k="start_date" v="2017-03-29"/>
 </node>
